{
  "name": "solana-x402-server",
  "version": "1.0.0",
  "description": "TypeScript/Express server with x402 payments on Solana devnet",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "x402",
    "solana",
    "express",
    "typescript",
    "payments",
    "usdc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.682.0",
    "axios": "^1.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "x402-express": "*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
